{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofline.dev/schemas/v1/verification-contract.schema.json",
  "title": "ProoflineVerificationContract",
  "description": "Declarative specification of verification criteria, attacker models, and execution boundaries for Project Proofline.",
  "type": "object",
  "required": [
    "contract_id",
    "target_artifact",
    "attacker_model",
    "verification_requirements",
    "execution_constraints"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "pattern": "^PVC-[0-9]{4}-[A-Z0-9_-]+$"
    },
    "target_artifact": {
      "type": "object",
      "required": ["repository", "vulnerable_commit"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "vulnerable_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "candidate_patch_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "subpath": {
          "type": "string"
        }
      }
    },
    "attacker_model": {
      "type": "object",
      "required": ["ingress_tier", "authentication", "capabilities"],
      "properties": {
        "ingress_tier": {
          "type": "string",
          "enum": [
            "UNTRUSTED_NETWORK_INPUT",
            "AUTHENTICATED_NETWORK_INPUT",
            "LOCAL_FILE_INPUT",
            "CLI_ARGUMENT_INPUT",
            "ENVIRONMENT_VARIABLE",
            "INTER_PROCESS_COMMUNICATION"
          ]
        },
        "authentication": {
          "type": "string",
          "enum": ["ANONYMOUS", "LOW_PRIVILEGE", "HIGH_PRIVILEGE", "INTERNAL_SERVICE"]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verification_requirements": {
      "type": "object",
      "required": [
        "reproduction_required",
        "reproduction_runs",
        "reproduction_success_threshold",
        "patch_bypass_fuzzing_duration_seconds",
        "patch_bypass_mutation_budget",
        "regression_suite_pass_threshold",
        "max_acceptable_epistemic_tier"
      ],
      "properties": {
        "reproduction_required": {
          "type": "boolean"
        },
        "reproduction_runs": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "reproduction_success_threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 1.0
        },
        "patch_bypass_fuzzing_duration_seconds": {
          "type": "integer",
          "minimum": 0,
          "default": 300
        },
        "patch_bypass_mutation_budget": {
          "type": "integer",
          "minimum": 0,
          "default": 50000
        },
        "regression_suite_pass_threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 1.0
        },
        "max_acceptable_epistemic_tier": {
          "type": "string",
          "enum": [
            "CONFIRMED_REPRODUCED",
            "SYMBOLICALLY_SATISFIABLE",
            "STATICALLY_TAINTED",
            "HEURISTIC_HYPOTHESIS",
            "VERIFIED_MITIGATION",
            "INCONCLUSIVE"
          ]
        }
      }
    },
    "execution_constraints": {
      "type": "object",
      "required": [
        "hypervisor",
        "guest_memory_mb",
        "guest_vcpus",
        "network_access",
        "wall_clock_timeout_seconds"
      ],
      "properties": {
        "hypervisor": {
          "type": "string",
          "enum": ["KVM_FIRECRACKER", "KVM_CLOUD_HYPERVISOR", "GVISOR_CONTAINER", "LANDLOCK_SANDBOX"]
        },
        "guest_kernel": {
          "type": "string"
        },
        "guest_memory_mb": {
          "type": "integer",
          "minimum": 256,
          "maximum": 65536
        },
        "guest_vcpus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "network_access": {
          "type": "string",
          "enum": ["DENIED", "HERMETIC_PROXY_ONLY", "ISOLATED_TEST_SUBNET"]
        },
        "wall_clock_timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 7200
        }
      }
    }
  }
}
